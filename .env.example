# HumanoidTH — Next.js / Prisma configuration
# Fill in .env locally. Keep real credentials out of .env.example.
# Restart the development server after editing this file.

# DATABASE — required for accounts, submissions, subscriptions and live data.
# Replace the user, password, host and database with your PostgreSQL settings.
# Use a postgresql:// or postgres:// connection string with the current pg adapter.
# URL-encode special characters in the database username/password.
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/humanoidth?schema=public"

# Optional direct connection for Prisma schema/migration commands.
# Leave this line commented when DATABASE_URL is already a direct connection.
# Do not enable it with an empty value.
# DIRECT_DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/humanoidth?schema=public"

# WEBSITE — keep these two URLs identical; change both when deploying.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# SITE_URL is an alternative to NEXT_PUBLIC_SITE_URL, not an additional requirement.
# SITE_URL="http://localhost:3000"

# ADMIN — set your own login email and a long, unique password.
# Both values are required for subscription management.
# The local .env created during setup contains a generated password.
ADMIN_BASIC_USER=""
ADMIN_BASIC_PASSWORD=""

# API KEYS — optional; leave unused services empty.
# Gemini: article classification and AI location grouping (server only).
GEMINI_API_KEY=""
# YouTube Data API: video ingestion (server only).
YOUTUBE_API_KEY=""
# GitHub: authenticated repository search (server only).
GITHUB_TOKEN=""
# Google Maps JavaScript API: Live Map.
# This key is visible in the browser; restrict it to your website domains and API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# NETWORK GRAPH — auto | file | database | hybrid
NETWORK_GRAPH_SOURCE="auto"
NETWORK_GRAPH_IMPORT_FILE_PATH="data/imports/thailand_humanoid_atlas_seed_records.json"

# DATABASE LOGGING — silent disables Prisma logs; error keeps normal error logs.
PRISMA_LOG_LEVEL="error"

# TESTS — uncomment only when Playwright should reuse a server you started.
# PLAYWRIGHT_EXTERNAL_SERVER="1"

# NODE_ENV, CI and VERCEL_URL are managed by the runtime/hosting platform.
# Billing, email delivery and file storage have no configurable providers wired up yet.
# Python/SQLite code under src/ uses separate legacy settings; do not use this
# PostgreSQL DATABASE_URL when running the legacy SQLite application.
