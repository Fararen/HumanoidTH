generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  SEED
  RSS
  GDELT
  YOUTUBE
  OPENALEX
  GITHUB
  MANUAL_SOCIAL
  SUBMISSION
  WEB
}

enum RelevanceStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNCERTAIN
}

enum ReviewStatus {
  QUEUED
  FETCHING
  ANALYZED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum UserRole {
  USER
  COMPANY
  ADMIN
}

enum CompanyMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum PullStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED_MISSING_KEY
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  role               UserRole            @default(USER)
  submissions        SubmittedData[]
  companyMemberships CompanyMembership[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Company {
  id               String                   @id @default(cuid())
  name             String                   @unique
  isVerified       Boolean                  @default(false)
  members          CompanyMembership[]
  modelEvaluations CompanyModelEvaluation[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model CompanyMembership {
  id        String            @id @default(cuid())
  userId    String
  companyId String
  role      CompanyMemberRole @default(EDITOR)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model SourceRecord {
  id                  String                  @id @default(cuid())
  sourceType          SourceType
  title               String
  url                 String                  @unique
  excerpt             String                  @default("")
  publishedAt         DateTime?
  author              String?
  platform            String?
  rawMeta             Json                    @default("{}")
  relevanceStatus     RelevanceStatus         @default(PENDING)
  relevanceReason     String?
  relevanceConfidence Float                   @default(0)
  annotations         PerspectiveAnnotation[]
  triplets            Triplet[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([sourceType])
  @@index([relevanceStatus])
  @@index([publishedAt])
}

model RobotModel {
  id                String         @id @default(cuid())
  canonicalName     String         @unique
  manufacturer      String?
  developerOrg      String?
  countryOfOrigin   String?
  robotType         String         @default("unknown")
  embodimentLevel   String?
  primaryUseCase    String?
  thailandStatus    String         @default("observed_in_thailand")
  statusConfidence  Float          @default(0.5)
  officialUrl       String?
  description       String?
  sourceMeta        Json           @default("{}")
  firstSeenYear     Int?
  lastVerifiedAt    DateTime?
  contributions     Contribution[]
  inventory         OwnedInventory[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([robotType])
  @@index([thailandStatus])
}

model Entity {
  id           String   @id @default(cuid())
  name         String
  entityType   String
  canonicalKey String   @unique
  sourceMeta   Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([entityType])
}

model Contribution {
  id                  String      @id @default(cuid())
  contributorName     String?
  contributorType     String?
  organization        String?
  contributionType    String
  title               String
  description         String?
  relatedRobotModelId String?
  relatedRobotModel   RobotModel? @relation(fields: [relatedRobotModelId], references: [id], onDelete: SetNull)
  sourceUrl           String?     @unique
  license             String?
  visibility          String      @default("public")
  verificationStatus  ReviewStatus @default(NEEDS_REVIEW)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([contributionType])
  @@index([verificationStatus])
}

model PerspectiveAnnotation {
  id                String       @id @default(cuid())
  sourceId          String
  source            SourceRecord @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  stance            String       @default("unclear")
  sentiment         String       @default("unclear")
  perspectiveTheme  String       @default("unclear")
  targetEntity      String       @default("humanoid/social robotics")
  evidenceExcerpt   String       @default("")
  confidence        Float        @default(0.5)
  method            String
  createdAt         DateTime     @default(now())

  @@unique([sourceId, perspectiveTheme, targetEntity, evidenceExcerpt])
  @@index([perspectiveTheme])
}

model Triplet {
  id         String        @id @default(cuid())
  subject    String
  relation   String
  object     String
  confidence Float         @default(0.5)
  sourceId   String?
  source     SourceRecord? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@unique([subject, relation, object, sourceId])
  @@index([relation])
}

model StatsCache {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model SubmittedData {
  id               String       @id @default(cuid())
  submissionType   String
  title            String
  url              String?
  payloadJson      Json         @default("{}")
  notes            String?
  submitterName    String?
  submitterContact String?
  status           ReviewStatus @default(QUEUED)
  reviewNotes      String?
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([submissionType])
}

model PipelineRun {
  id           String     @id @default(cuid())
  pipelineName String
  status       PullStatus
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  detailsJson  Json       @default("{}")

  @@index([pipelineName])
  @@index([status])
}

model SourcePullJob {
  id           String     @id @default(cuid())
  adapter      SourceType
  query        String
  status       PullStatus @default(QUEUED)
  recordsFound Int        @default(0)
  recordsSaved Int        @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([adapter])
  @@index([status])
}

model OwnedInventory {
  id                 String      @id @default(cuid())
  robotModelId       String?
  robotModel         RobotModel? @relation(fields: [robotModelId], references: [id], onDelete: SetNull)
  displayName        String
  ownershipStatus    String
  ownerOrg           String?
  custodian          String?
  locationLabel      String?
  serialNumber       String?
  publicSerialSafe   Boolean     @default(false)
  acquisitionDate    DateTime?
  acquisitionSource  String?
  conditionStatus    String?
  firmwareVersion    String?
  accessories        Json        @default("[]")
  documentationLinks Json        @default("[]")
  visibility         String      @default("private")
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([robotModelId])
}


model CommunityPost {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  content        String
  type           String             @default("DISCUSSION")
  communityName  String             @default("r/HumanoidTH")
  authorName     String             @default("Robotics Explorer")
  authorHandle   String             @default("robotics_explorer")
  authorBadge    String             @default("Community Member")
  isVerified     Boolean            @default(false)
  mediaUrl       String?
  tags           String[]
  upvotes        Int                @default(1)
  downvotes      Int                @default(0)
  viewsCount     Int                @default(1)
  isPinned       Boolean            @default(false)
  comments       CommunityComment[]
  votes          CommunityVote[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([communityName])
}

model CommunityComment {
  id           String             @id @default(cuid())
  postId       String
  post         CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      CommunityComment[] @relation("CommentReplies")
  content      String
  authorName   String             @default("Robotics Enthusiast")
  authorHandle String             @default("enthusiast")
  authorBadge  String             @default("Robotics Enthusiast")
  isVerified   Boolean            @default(false)
  upvotes      Int                @default(1)
  downvotes    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([postId])
  @@index([parentId])
}

model CommunityVote {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userKey   String
  voteType  String
  createdAt DateTime      @default(now())

  @@unique([postId, userKey])
}

model ChallengeSubmission {
  id             String   @id @default(cuid())
  challengeId    String
  teamName       String
  contactEmail   String
  solutionTitle  String
  description    String?
  repoUrl        String?
  dockerImage    String?
  hardwareSpecs  String?
  benchmarkScore Float?
  status         String   @default("SUBMITTED")
  submittedAt    DateTime @default(now())

  @@index([challengeId])
  @@index([status])
}


model HriSimulationRun {
  id                  String   @id @default(cuid())
  runCode             String   @unique
  robotId             String
  robotName           String
  sceneVersion        String   @default("wellness-reception-v1.0")
  simulationMode      String   @default("interactive-hri-living-lab")
  testCaseType        String
  terminalStatus      String
  testCasePassed      Boolean  @default(true)
  navigationSucceeded Boolean  @default(false)
  durationSec         Float
  errorReason         String?
  eventsJson          Json     @default("[]")
  createdAt           DateTime @default(now())

  @@index([robotId])
  @@index([testCaseType])
  @@index([createdAt])
}


model CompanyModelEvaluation {
  id                  String   @id @default(cuid())
  companyId           String?
  company             Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  modelCode           String
  version             String   @default("v1.0.0")
  groupId             String   @default("industrial-pick-place")
  groupName           String   @default("หุ่นยนต์หยิบวางชิ้นงานในภาคการผลิต (Industrial Pick & Place)")
  protocolCode        String   @default("TH-IND-PP-2026.1")
  companyName         String
  contactName         String
  contactEmail        String
  contactPhone        String?
  modelName           String
  robotClass          String   @default("Industrial Cobot / Manipulator")
  hardwareSpec        String
  firmwareVersion     String
  taskEvaluated       String   @default("การหยิบวางชิ้นงานความละเอียดสูงบนสายพาน (High-Precision Bin Picking & Palletizing)")
  testConditions      String   @default("ชิ้นงานมาตรฐาน 250g · ความเร็วสายพานคงที่ · ทดสอบต่อเนื่อง 50 รอบภายใต้โปรโตคอล TH-IND-PP-2026.1")
  workflowStatus      String   @default("DRAFT")
  safetyStatus        String   @default("PENDING")
  precisionMm         Float?
  speedSec            Float?
  evaluatorName       String?  @default("ดร. ภาคภูมิ วงศ์วิศิษฏ์ (Lead Protocol Evaluator)")
  evaluatorNotes      String?
  sampleReportTitle   String?
  sampleReportSummary String?
  evidenceLinksJson   Json     @default("[]")
  publishedFieldsJson Json     @default("{}")
  isPublished         Boolean  @default(false)
  allowContact        Boolean  @default(true)
  isDemoData          Boolean  @default(true)
  evaluatedAt         DateTime @default(now())
  publishedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([modelCode, version])
  @@index([companyId])
  @@index([groupId, isPublished])
  @@index([workflowStatus])
}
